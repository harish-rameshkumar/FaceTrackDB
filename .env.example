POSTGRES_USER=facetrack
POSTGRES_PASSWORD=change_me
POSTGRES_DB=facetrackdb
DATABASE_URL=postgresql://facetrack:change_me@localhost:5432/facetrackdb
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change_me_qdrant
# Random string, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
# Embedding service (docker compose service "embedder", bound to 127.0.0.1:8001).
# EMBEDDER_TOKEN is a shared secret, at least 16 characters: openssl rand -hex 16
EMBEDDER_URL=http://127.0.0.1:8001
EMBEDDER_TOKEN=change_me_embedder_token
# Cosine similarity thresholds. STARTING GUESSES until you run `npm run faces:eval`.
MATCH_MIN_SIMILARITY=0.50
REVIEW_MIN_SIMILARITY=0.35
MIN_MARGIN=0.08
# Quality gate for every image
FACE_MIN_DET_SCORE=0.6
FACE_MIN_WIDTH=80
FACE_MIN_BLUR=20
SCAN_COOLDOWN_SECONDS=20
