// ===== PEOPLE (blue) =====
Table users [headercolor: #2E5C8A] {
  user_id int [pk, increment]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(20) [not null, note: 'student, parent, warden, security, admin']
  created_at timestamp [not null, default: `now()`]
}

Table students [headercolor: #2E5C8A] {
  student_id int [pk, increment]
  user_id int [not null, unique, ref: - users.user_id]
  roll_no varchar(20) [not null, unique]
  name varchar(100) [not null]
  hostel_id int [not null, ref: > hostels.hostel_id]
  room_no varchar(10)
}

Table parents [headercolor: #2E5C8A] {
  parent_id int [pk, increment]
  user_id int [not null, unique, ref: - users.user_id]
  name varchar(100) [not null]
  phone varchar(15)
}

Table student_parent [headercolor: #2E5C8A] {
  student_id int [not null, ref: > students.student_id]
  parent_id int [not null, ref: > parents.parent_id]
  relation varchar(20)
  indexes {
    (student_id, parent_id) [pk]
  }
}

// ===== HOSTEL AND FACE RECOGNITION (green) =====
Table hostels [headercolor: #2F7D5B] {
  hostel_id int [pk, increment]
  name varchar(100) [not null, unique]
}

Table gates [headercolor: #2F7D5B] {
  gate_id int [pk, increment]
  hostel_id int [not null, ref: > hostels.hostel_id]
  name varchar(50) [not null]
}

Table cameras [headercolor: #2F7D5B] {
  camera_id int [pk, increment]
  gate_id int [not null, ref: > gates.gate_id]
  location varchar(100)
  status varchar(15) [not null, note: 'active, inactive']
}

Table face_profiles [headercolor: #2F7D5B] {
  profile_id int [pk, increment]
  student_id int [not null, ref: > students.student_id]
  qdrant_point_id uuid [not null, unique, note: 'id of the vector stored in Qdrant']
  enrolled_at timestamp [not null, default: `now()`]
}

Table face_events [headercolor: #2F7D5B] {
  event_id int [pk, increment]
  camera_id int [not null, ref: > cameras.camera_id]
  student_id int [ref: > students.student_id, note: 'null when no match']
  confidence numeric(4,3)
  outcome varchar(20) [not null, note: 'matched, low_confidence, no_match']
  event_time timestamp [not null, default: `now()`]
  reviewed_by int [ref: > users.user_id, note: 'warden who reviewed a low-confidence event']
}

// ===== ACTIVITY AND RULES (orange) =====
Table attendance_sessions [headercolor: #B7692B] {
  session_id int [pk, increment]
  hostel_id int [not null, ref: > hostels.hostel_id]
  session_date date [not null]
  start_time time [not null]
  end_time time [not null]
  indexes {
    (hostel_id, session_date, start_time) [unique]
  }
}

Table attendance [headercolor: #B7692B] {
  session_id int [not null, ref: > attendance_sessions.session_id]
  student_id int [not null, ref: > students.student_id]
  event_id int [ref: > face_events.event_id, note: 'null if marked manually']
  status varchar(20) [not null, note: 'present, absent, low_confidence']
  marked_at timestamp
  indexes {
    (session_id, student_id) [pk]
  }
}

Table entry_exit_log [headercolor: #B7692B] {
  log_id int [pk, increment]
  student_id int [not null, ref: > students.student_id]
  gate_id int [not null, ref: > gates.gate_id]
  event_id int [ref: > face_events.event_id]
  direction varchar(3) [not null, note: 'IN or OUT']
  event_time timestamp [not null, default: `now()`]
}

Table leave_requests [headercolor: #B7692B] {
  leave_id int [pk, increment]
  student_id int [not null, ref: > students.student_id]
  start_date date [not null]
  end_date date [not null]
  reason text
  status varchar(15) [not null, note: 'pending, approved, rejected']
  decided_by int [ref: > parents.parent_id]
  decided_at timestamp
}

Table violations [headercolor: #A33A3A] {
  violation_id int [pk, increment]
  student_id int [not null, ref: > students.student_id]
  log_id int [ref: > entry_exit_log.log_id]
  session_id int [ref: > attendance_sessions.session_id]
  type varchar(30) [not null, note: 'late_return, missed_attendance, no_leave']
  details text
  raised_at timestamp [not null, default: `now()`]
  status varchar(15) [not null, note: 'open, resolved']
  resolved_by int [ref: > users.user_id]
}