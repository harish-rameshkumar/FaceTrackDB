  event_id int
  status varchar(20) [not null]
  marked_at timestamp
  indexes {
    (session_id, student_id) [pk]
  }
}

Table attendance_sessions [headercolor: #B7692B] {
  session_id int [pk]
  hostel_id int [not null, ref: > hostels.hostel_id]
  session_date date [not null]
  start_time time [not null]
  end_time time [not null]
}

Table b_consents [headercolor: #2E5C8A] {
  student_id int [pk, ref: > students.student_id]
  consented_at timestamp [not null]
  recorded_by int [ref: > users.user_id]
}

Table b_demo_rows [headercolor: #6B6B6B] {
  kind text
  row_id int
  indexes {
    (kind, row_id) [pk]
  }
}

Table b_meta [headercolor: #6B6B6B] {
  key text [pk]
  value text [not null]
  updated_at timestamp [not null]
}

Table cameras [headercolor: #2F7D5B] {
  camera_id int [pk]
  gate_id int [not null, ref: > gates.gate_id]
  location varchar(100)
  status varchar(15) [not null]
}

Table entry_exit_log [headercolor: #B7692B] {
  log_id int [pk]
  student_id int [not null, ref: > students.student_id]
  gate_id int [not null, ref: > gates.gate_id]
  event_id int
  direction varchar(3) [not null]
  event_time timestamp [not null]
}

Table face_events [headercolor: #1F7A7A] {
  event_id int [pk]
  camera_id int [not null, ref: > cameras.camera_id]
  student_id int [ref: > students.student_id]
  confidence numeric(4,3)
  outcome varchar(20) [not null]
  event_time timestamp [not null]
  reviewed_by int [ref: > users.user_id]
}

Table face_profiles [headercolor: #1F7A7A] {
  profile_id int [pk]
  student_id int [not null, ref: > students.student_id]
  qdrant_point_id uuid [not null]
  enrolled_at timestamp [not null]
}

Table gates [headercolor: #2F7D5B] {
  gate_id int [pk]
  hostel_id int [not null, ref: > hostels.hostel_id]
  name varchar(50) [not null]
}

Table hostels [headercolor: #2F7D5B] {
  hostel_id int [pk]
  name varchar(100) [not null]
}

Table leave_requests [headercolor: #B7692B] {
  leave_id int [pk]
  student_id int [not null, ref: > students.student_id]
  start_date date [not null]
  end_date date [not null]
  reason text
  status varchar(15) [not null]
  decided_by int
  decided_at timestamp
  reason_tsv tsvector
}

Table login_attempts [headercolor: #6B6B6B] {
  attempt_id bigint [pk]
  email varchar(255) [not null]
  ip varchar(64) [not null]
  succeeded boolean [not null]
  attempted_at timestamp [not null]
}

Table parents [headercolor: #2E5C8A] {
  parent_id int [pk]
  user_id int [not null, ref: > users.user_id]
  name varchar(100) [not null]
  phone varchar(15)
}

Table student_parent [headercolor: #2E5C8A] {
  student_id int [ref: > students.student_id]
  parent_id int [ref: > parents.parent_id]
  relation varchar(20)
  indexes {
    (student_id, parent_id) [pk]
  }
}

Table students [headercolor: #2E5C8A] {
  student_id int [pk]
  user_id int [not null, ref: > users.user_id]
  roll_no varchar(20) [not null]
  name varchar(100) [not null]
  hostel_id int [not null, ref: > hostels.hostel_id]
  room_no varchar(10)
}

Table users [headercolor: #2E5C8A] {
  user_id int [pk]
  email varchar(255) [not null]
  password_hash varchar(255) [not null]
  role varchar(20) [not null]
  created_at timestamp [not null]
  token_version int [not null]
}

Table violations [headercolor: #A33A3A] {
  violation_id int [pk]
  student_id int [not null, ref: > students.student_id]
  log_id int
  session_id int [ref: > attendance_sessions.session_id]
  type varchar(30) [not null]
  details text
  raised_at timestamp [not null]
  status varchar(15) [not null]
  resolved_by int [ref: > users.user_id]
  resolved_at timestamp
  details_tsv tsvector
}

Ref attendance_event_fk: attendance.(event_id, student_id) > face_events.(event_id, student_id)
Ref log_event_fk: entry_exit_log.(event_id, student_id) > face_events.(event_id, student_id)
Ref leave_decider_is_parent: leave_requests.(student_id, decided_by) > student_parent.(student_id, parent_id)
Ref violations_log_fk: violations.(log_id, student_id) > entry_exit_log.(log_id, student_id)
